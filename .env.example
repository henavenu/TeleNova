# TeleNova/.env — copy to .env (gitignored). One LLM provider is needed only for the
# router's fallback classifier; the demo scenarios are deterministic.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# LLM_DISABLED=true            # run with no LLM at all
TRUST_APP_ID=telenova
RAI_APP_KEY=                   # written by onboard_trust.py
TRUST_PE_URL=http://127.0.0.1:3003
PAP_URL=http://127.0.0.1:3002
TRUST_DASHBOARD_URL=http://127.0.0.1:3004/ui/dashboard
APP_PORT=5002
