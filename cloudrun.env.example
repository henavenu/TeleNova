# TeleNova on Cloud Run — environment variables (copy to cloudrun.env for docker run --env-file;
# on Cloud Run set them on the service). Comments stay on their own lines: --env-file keeps
# anything after '=' as the value. RAI_APP_KEY belongs in Secret Manager.

# ── RAI Trust SDK (names must match exactly; SDK URLs end with a slash) ───────
RAI_PE_URL=https://neuro-ai-trust-platform-82745682889.us-east1.run.app/pe/
RAI_PAP_URL=https://neuro-ai-trust-platform-82745682889.us-east1.run.app/pap/
RAI_EVAL_MODE=SYNC
RAI_ENFORCEMENT_MODE=RAISE
RAI_TIMEOUT=30
RAI_PRIVACY_PROXY=regex
RAI_GOVERN_RETURNS=false

# ── App identity on the platform ──────────────────────────────────────────────
TRUST_APP_ID=telenova
# secret: the full <key_id>.<secret> credential issued for app_id telenova
RAI_APP_KEY=

# ── Platform URLs the app calls directly (no trailing slash; both required at startup) ──
TRUST_PE_URL=https://neuro-ai-trust-platform-82745682889.us-east1.run.app/pe
PAP_URL=https://neuro-ai-trust-platform-82745682889.us-east1.run.app/pap
TRUST_DASHBOARD_URL=https://neuro-ai-trust-platform-82745682889.us-east1.run.app/ui/dashboard

# ── LLM (optional: the demo scenarios are deterministic; the LLM is only the router's
# fallback classifier). Gemini on Vertex AI needs roles/aiplatform.user on the service account.
# Use the project ID, not the display name (cb9252819a-raigov-gc gives 403 CONSUMER_INVALID).
GOOGLE_CLOUD_PROJECT=cog01kmzvxwkcp4jrwtxtgttgsnh0
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash
